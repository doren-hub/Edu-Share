NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# テスト生成・記述採点用 LLM: Anthropic または Gemini のどちらか一方を設定（両方ある場合は Anthropic が既定）
# Anthropic: https://console.anthropic.com/ → API Keys（sk-ant-api03-...）
ANTHROPIC_API_KEY=your_anthropic_key
# 任意
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini のみ使う場合: https://aistudio.google.com/apikey でキー発行し、例:
# GEMINI_API_KEY=（発行したキー）
# （代替名）GOOGLE_API_KEY でも可
# 単一: GEMINI_MODEL=gemini-2.5-flash
# 503 時に別モデルへ: GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash（キーで 2.0 が使えない場合は外す）
# 同一モデルの再試行回数（既定 4）。503/429 などで指数バックオフします。
# GEMINI_RETRY_MAX=4
# Anthropic も設定済みのときに Gemini を強制したい場合:
# LLM_PROVIDER=gemini

# 任意: 未設定ならチャンクはランダム取得（ベクトル検索はスキップ）
OPENAI_API_KEY=your_openai_key_for_embeddings
