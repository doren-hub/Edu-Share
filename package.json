{
  "name": "edu-share-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:build-apply-all": "node --experimental-strip-types tools/build-apply-all-migrations.ts",
    "db:check-apply-all": "node --experimental-strip-types tools/build-apply-all-migrations.ts --check",
    "storage:migrate:r2": "node --env-file-if-exists=.env.local --experimental-strip-types tools/migrate-storage-to-r2.ts",
    "backfill:pdf-filename": "node --env-file-if-exists=.env.local --experimental-strip-types tools/backfill-pdf-filename.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@google/generative-ai": "^0.21.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "d3-force": "^3.0.0",
    "jsonrepair": "^3.13.3",
    "next": "^15.5.28",
    "openai": "7.45.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
