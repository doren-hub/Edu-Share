# 未処理の論文 PDF を置くディレクトリ（必須）
PAPER_INBOX_DIR=/Users/doren/Developer/edu-share-papers/inbox

# 作業・完了後の置き場。入力とは別にする（必須）
PAPER_WORK_DIR=/Users/doren/Developer/edu-share-papers/work

# Edu Share のベース URL
EDU_SHARE_BASE_URL=http://localhost:3000

# SciSpace の Notebooks フォルダ
SCISPACE_FOLDER_URL=https://scispace.com/folder/notebooks-enu289ww

NOTEBOOKLM_URL=https://notebooklm.google.com/

# 任意: NotebookLM の Export 拡張（CSV 用）。未設定なら初回プロファイルで手動インストール
# macOS 例: ~/Library/Application Support/Google/Chrome/Default/Extensions/<id>/<version>
# NOTEBOOKLM_EXPORT_EXTENSION_PATH=

# Playwright 用 Chrome プロファイル（このディレクトリは git に入れない）
# CHROME_USER_DATA_DIR=.chrome-profile

# 任意: Edu Share ログイン画面を自動入力（未設定ならブラウザで手ログイン）
# EDU_SHARE_EMAIL=
# EDU_SHARE_PASSWORD=

# Notebook 利用量（taskdesk / ai-usage-board と同じ JSON）。短期枠 85% 超で生成停止、週枠 100% はリセットまで待つ
# TASKDESK_URL=http://127.0.0.1:8765
# AI_USAGE_BOARD_URL=http://127.0.0.1:8766
# TASKDESK_USAGE_URL=http://127.0.0.1:8766/usage-latest.json
# NOTEBOOK_SHORT_STOP_PERCENT=85
# NOTEBOOK_WEEKLY_STOP_PERCENT=100
# IGNORE_NOTEBOOK_QUOTA=0

# 1件失敗でバッチ全体を止める場合は 1
# STOP_ON_ERROR=0
